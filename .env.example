# Copy to .env.local (local) or set in your host's environment settings.
# Never commit real values.

# --- ZeptoMail API delivery (production) --------------------------------------
MAIL_DRIVER=zeptomail
# Real Zoho agent send token, raw or prefixed with Zoho-enczapikey. Never NEXT_PUBLIC_.
ZEPTOMAIL_TOKEN=
# Full authorised sender on the verified domain (sample @daramanihot.com.ng is incomplete).
ZEPTOMAIL_FROM_EMAIL=noreply@daramanihot.com.ng
# Company recipient for notifications; visitor acknowledgement replies go here.
ENQUIRY_TO=info@daramanihot.com.ng

# Legacy SMTP is still available only when selected/configured instead of ZeptoMail.
# MAIL_DRIVER=smtp
# SMTP_HOST=mail.daramanihot.com.ng
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@daramanihot.com.ng
# SMTP_PASS=
# MAIL_FROM="Dara-Manihot <noreply@daramanihot.com.ng>"

# --- Site -------------------------------------------------------------------
# Used for the logo in emails. Set to the staging URL while on staging.
NEXT_PUBLIC_SITE_URL=https://www.daramanihot.com.ng

# Staging only: print the photo brief inside empty image slots for client review.
# NEXT_PUBLIC_SHOW_PHOTO_SLOTS=true

# --- Testing only -----------------------------------------------------------
# MAIL_DRIVER=json builds the emails but sends NOTHING. Never set in production:
# real enquiries would be silently dropped. `pnpm launch:check` flags it.
# MAIL_DRIVER=json
