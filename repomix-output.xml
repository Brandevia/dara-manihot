<file path="hooks/use-cookie-consent.ts">
'use client'

import { useSyncExternalStore } from 'react'
import {
  type ConsentState,
  getConsentSnapshot,
  getServerConsentSnapshot,
  resetConsent,
  setConsent,
  subscribeConsent,
} from '@/lib/cookie-consent'

/**
 * The visitor's cookie choice, kept in step across components and tabs.
 * `state` is `loading` on the server and during hydration, so server and
 * client markup match.
 */
export function useCookieConsent(): {
  state: ConsentState
  accept: () => void
  decline: () => void
  /** Forget the choice so the banner asks again. */
  reopen: () => void
} {
  const state = useSyncExternalStore(
    subscribeConsent,
    getConsentSnapshot,
    getServerConsentSnapshot,
  )
  return {
    state,
    accept: () => setConsent('accepted'),
    decline: () => setConsent('declined'),
    reopen: resetConsent,
  }
}
</file>

<file path="hooks/use-fine-pointer.ts">
'use client'

import { useSyncExternalStore } from 'react'

/** A mouse or trackpad that can hover. Phones and tablets do not match. */
const QUERY = '(hover: hover) and (pointer: fine)'

function subscribe(onChange: () => void) {
  const mql = window.matchMedia(QUERY)
  mql.addEventListener('change', onChange)
  return () => mql.removeEventListener('change', onChange)
}

/**
 * True when the visitor has a precise, hovering pointer (desktop and laptop).
 * Used to decide between a styled listbox and the phone's own native picker.
 *
 * The server and the first client render both report `false`, so hydration
 * always matches and a touch device never sees anything but the native control.
 */
export function useFinePointer(): boolean {
  return useSyncExternalStore(
    subscribe,
    () => window.matchMedia(QUERY).matches,
    () => false,
  )
}
</file>

