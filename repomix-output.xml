              href={`/projects/${project.slug}`}
              className="group/ask mt-8 inline-flex items-center gap-2 rounded-sm font-medium text-canopy underline-offset-4 outline-none hover:underline focus-visible:ring-[3px] focus-visible:ring-ring/50"
            >
              Ask about project
              <span className="sr-only"> {project.title}</span>
              <ArrowUpRight
                aria-hidden
                className="size-4 transition-transform duration-200 group-hover/ask:translate-x-0.5 group-hover/ask:-translate-y-0.5"
              />
            </Link>
          )}
        </Reveal>

        <Reveal delay={0.1}>
          <dl className="space-y-6 lg:pt-3">
            <div>
              <dt className={labelClass}>Status</dt>
              <dd className="mt-1 text-lg font-medium">{project.status}</dd>
            </div>
            <div>
              <dt className={labelClass}>Goal</dt>
              <dd className="mt-1 text-lg font-medium">{project.goal}</dd>
            </div>
            {/* Only shown when there is an impact figure to claim. */}
            {project.impact && (
              <div>
                <dt className={labelClass}>Impact</dt>
                <dd className="mt-1 text-lg font-medium">
                  <CountUp value={project.impact} />
                </dd>
              </div>
            )}
          </dl>
        </Reveal>
      </div>

      <Reveal delay={0.1} className="mt-12">
        <PhotoSlot
          id={project.photo}
          sizes="(min-width: 1280px) 1216px, 100vw"
          priority={asPage}
          className="aspect-[16/8] rounded-xl"
        />
      </Reveal>
    </article>
  )
}
