<file path="hooks/use-scrolled-past.ts">
'use client'

import { useCallback, useSyncExternalStore } from 'react'

/**
 * True once the page has scrolled past `threshold` pixels.
 *
 * Built on useSyncExternalStore: the snapshot is a boolean, so React only
 * re-renders when it flips, not on every scroll event (the previous hook
 * stored the raw scroll offset in state and re-rendered the whole nav on
 * every scroll tick).
 */
export function useScrolledPast(threshold: number): boolean {
  const subscribe = useCallback((onChange: () => void) => {
    window.addEventListener('scroll', onChange, { passive: true })
    return () => window.removeEventListener('scroll', onChange)
  }, [])

  const getSnapshot = useCallback(() => window.scrollY > threshold, [threshold])

  return useSyncExternalStore(subscribe, getSnapshot, () => false)
}
</file>

<file path="lib/cookie-consent.ts">
/**
 * Cookie consent: what the visitor chose, and for how long it is remembered.
 *
 * The site sets no cookies of its own. The one thing that needs permission is
 * the Google map on the Contact page, because Google receives the visitor's
 * IP address and may set cookies once it loads (see the Privacy Policy). So
 * "accepted" means "the map may load", and nothing else is gated on it.
 *
 * The choice is kept in the browser's localStorage, not in a cookie, so
 * remembering "no" never sets a cookie itself, and it is never sent to our
 * server. It lasts 12 months, then the visitor is asked again. Changing
 * CONSENT_VERSION asks everyone again (do that when the policy changes what
 * accepting covers).
 *
 * State is read straight from storage on every call and pushed to subscribers
 * on change, so it plugs into `useSyncExternalStore` (hooks/use-cookie-consent)
 * and stays in step across tabs.
 */

export const CONSENT_KEY = 'dm-cookie-consent'
export const CONSENT_VERSION = 1
/** 12 months. The Privacy Policy says "12 months"; keep them in step. */
export const CONSENT_MAX_AGE_MS = 365 * 24 * 60 * 60 * 1000
/** Tolerated clock skew for a stored timestamp that looks like the future. */
const CLOCK_SKEW_MS = 5 * 60 * 1000

export type ConsentChoice = 'accepted' | 'declined'

/**
 * `loading`: server render and hydration, before storage can be read (render
 * as if undecided, but show no banner, so nothing flashes for returning
 * visitors). `unset`: no valid choice on record.
 */
export type ConsentState = 'loading' | 'unset' | ConsentChoice

export function serializeConsent(choice: ConsentChoice, now: number): string {
  return JSON.stringify({
    v: CONSENT_VERSION,
    choice,
    at: new Date(now).toISOString(),
  })
}

/** Returns the stored choice, or null if absent, malformed, old or expired. */
export function parseConsent(
  raw: string | null | undefined,
  now: number,
): ConsentChoice | null {
  if (!raw) return null
  let value: unknown
  try {
    value = JSON.parse(raw)
  } catch {
    return null
  }
  if (!value || typeof value !== 'object') return null
  const { v, choice, at } = value as Record<string, unknown>
  if (v !== CONSENT_VERSION) return null
  if (choice !== 'accepted' && choice !== 'declined') return null
  if (typeof at !== 'string') return null
  const given = Date.parse(at)
  if (!Number.isFinite(given)) return null
  if (given > now + CLOCK_SKEW_MS) return null
  if (now - given >= CONSENT_MAX_AGE_MS) return null
  return choice
}

// ---------------------------------------------------------------------------
// Store
// ---------------------------------------------------------------------------

const listeners = new Set<() => void>()

/**
 * Used only when localStorage throws (Safari private mode, blocked site
 * data), so the choice at least holds for the page session instead of the
 * banner coming back on every navigation. Never consulted while storage works.
 */
let memory: string | null = null

function readRaw(): string | null {
  try {
    return window.localStorage.getItem(CONSENT_KEY)
  } catch {
    return memory
  }
}

function writeRaw(raw: string | null): void {
  memory = raw
  try {
    if (raw === null) window.localStorage.removeItem(CONSENT_KEY)
    else window.localStorage.setItem(CONSENT_KEY, raw)
  } catch {
    // Storage unavailable: `memory` holds it for this page session.
  }
}

function emit(): void {
  for (const listener of listeners) listener()
}

/** Current state on the client. Cheap and returns a primitive, as React needs. */
export function getConsentSnapshot(): ConsentState {
  return parseConsent(readRaw(), Date.now()) ?? 'unset'
}

/** What the server renders, and what hydration starts from. */
export function getServerConsentSnapshot(): ConsentState {
  return 'loading'
}

export function subscribeConsent(listener: () => void): () => void {
  listeners.add(listener)
  // Another tab changed (or cleared) the choice.
  const onStorage = (event: StorageEvent) => {
    if (event.key === CONSENT_KEY || event.key === null) listener()
  }
  window.addEventListener('storage', onStorage)
  return () => {
    listeners.delete(listener)
    window.removeEventListener('storage', onStorage)
  }
}

export function setConsent(choice: ConsentChoice): void {
  writeRaw(serializeConsent(choice, Date.now()))
  emit()
}

/** Forget the choice: the banner returns, and the map is withdrawn. */
export function resetConsent(): void {
  writeRaw(null)
  emit()
}
</file>

<file path="lib/enquiry-handler.ts">
import { randomBytes } from 'node:crypto'
import { validateEnquiry } from '@/lib/enquiry'
import { MailNotConfiguredError, sendEnquiryEmails } from '@/lib/mailer'
import {
  clientIp,
  detectBot,
  globalLimiter,
  perIpLimiter,
  type RateLimiter,
} from '@/lib/spam'

/**
 * POST /api/enquiry, with its collaborators injectable so every branch can be
 * tested without a mail server or a clock. app/api/enquiry/route.ts is a thin
 * wrapper around this.
 *
 * Order matters: cheap checks first (size, type, origin, rate limit, bot
 * traps), validation next, and only then any email is sent.
 *
 * "Website records the enquiry" (scope 4.6, step 2): the site has no database,
 * and serverless disks do not persist, so the record is (a) a PII free
 * structured log line per enquiry, keyed by reference number, and (b) the full
 * notification email, which lands in the Dara-Manihot mailbox. The reference
 * number appears in both emails and the log so any enquiry can be traced.
 */

export const MAX_BODY_BYTES = 20_000

export interface HandlerDeps {
  now: () => number
  send: typeof sendEnquiryEmails
  perIp: RateLimiter
  global: RateLimiter
  log: (entry: Record<string, unknown>) => void
}

const defaultDeps: HandlerDeps = {
  now: () => Date.now(),
  send: sendEnquiryEmails,
  perIp: perIpLimiter,
  global: globalLimiter,
  log: (entry) => console.info(JSON.stringify(entry)),
}

const json = (body: unknown, status: number, headers?: HeadersInit) =>
  Response.json(body, {
    status,
    headers: { 'Cache-Control': 'no-store', ...headers },
  })

/** DM-YYMMDD-XXXX: dated for humans, random suffix so it cannot be guessed. */
export function makeReference(now: number): string {
  const d = new Date(now)
  const stamp = [d.getUTCFullYear() % 100, d.getUTCMonth() + 1, d.getUTCDate()]
    .map((n) => String(n).padStart(2, '0'))
    .join('')
  // No 0/O/1/I so it can be read out over the phone.
  const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'
  const suffix = Array.from(
    randomBytes(4),
    (b) => alphabet[b % alphabet.length],
  ).join('')
  return `DM-${stamp}-${suffix}`
}

function sameOrigin(request: Request): boolean {
  const origin = request.headers.get('origin')
  if (!origin) return true // non browser clients send none; not a security gate
  const host =
    request.headers.get('x-forwarded-host') ?? request.headers.get('host')
  try {
    return new URL(origin).host === host
  } catch {
    return false
  }
}

export async function handleEnquiry(
  request: Request,
  overrides: Partial<HandlerDeps> = {},
): Promise<Response> {
  const deps = { ...defaultDeps, ...overrides }
  const now = deps.now()

  if (!request.headers.get('content-type')?.includes('application/json'))
    return json({ ok: false, error: 'Unsupported content type.' }, 415)

  if (!sameOrigin(request))
    return json({ ok: false, error: 'Request not allowed.' }, 403)

  const raw = await request.text()
  if (Buffer.byteLength(raw) > MAX_BODY_BYTES)
    return json({ ok: false, error: 'Your message is too large.' }, 413)

  let body: unknown
  try {
    body = JSON.parse(raw)
  } catch {
    return json({ ok: false, error: 'Invalid request.' }, 400)
  }
  if (!body || typeof body !== 'object' || Array.isArray(body))
    return json({ ok: false, error: 'Invalid request.' }, 400)

  const ip = clientIp(request.headers)
  const ipLimit = deps.perIp.check(ip, now)
  const globalLimit = ipLimit.allowed
    ? deps.global.check('all', now)
    : { allowed: true, retryAfterSec: 0 }
  if (!ipLimit.allowed || !globalLimit.allowed) {
    const retryAfter = ipLimit.allowed
      ? globalLimit.retryAfterSec
      : ipLimit.retryAfterSec
    deps.log({
      event: 'enquiry.rate_limited',
      scope: ipLimit.allowed ? 'global' : 'ip',
    })
    return json(
      {
        ok: false,
        error:
          'Too many enquiries just now. Please try again a little later, or call us.',
      },
      429,
      { 'Retry-After': String(retryAfter) },
    )
  }

  const bot = detectBot(body as Record<string, unknown>, now)
  if (bot) {
    // Pretend it worked so the bot learns nothing and does not adapt.
    deps.log({ event: 'enquiry.spam_rejected', reason: bot })
    return json(
      { ok: true, reference: makeReference(now), acknowledged: true },
      200,
    )
  }

  const result = validateEnquiry(body)
  if (!result.ok) return json({ ok: false, errors: result.errors }, 422)

  const reference = makeReference(now)
  const receivedAt = new Date(now).toISOString()
  deps.log({
    event: 'enquiry.received',
    reference,
    service: result.data.service,
    receivedAt,
  })

  try {
    const sent = await deps.send(result.data, { reference, receivedAt })
    deps.log({
      event: 'enquiry.delivered',
      reference,
      acknowledged: sent.acknowledged,
    })
    return json({ ok: true, reference, acknowledged: sent.acknowledged }, 200)
  } catch (error) {
    const notConfigured = error instanceof MailNotConfiguredError
    console.error(
      JSON.stringify({
        event: 'enquiry.delivery_failed',
        reference,
        notConfigured,
        error: error instanceof Error ? error.message : String(error),
      }),
    )
    return json(
      {
        ok: false,
        reference,
        error:
          'We could not send your enquiry just now. Please email or call us directly using the details on this page.',
      },
      notConfigured ? 503 : 502,
    )
  }
}
</file>

<file path="lib/enquiry.ts">
import { PILLARS, SERVICES } from '@/lib/services'

/**
 * Enquiry form contract, shared by the browser form and the API route so the
 * two can never disagree about what is valid.
 */

export interface EnquiryInput {
  name: string
  email: string
  phone: string
  service: string
  message: string
}

export type EnquiryField = keyof EnquiryInput
export type EnquiryErrors = Partial<Record<EnquiryField, string>>

export type EnquiryResult =
  | { ok: true; data: EnquiryInput }
  | { ok: false; errors: EnquiryErrors }

export const ENQUIRY_LIMITS = {
  name: { min: 2, max: 100 },
  email: { max: 254 },
  phone: { minDigits: 7, maxDigits: 15 },
  message: { min: 10, max: 2000 },
} as const

export const GENERAL_ENQUIRY = 'general'

export interface ServiceOption {
  value: string
  label: string
  /** Pillar heading used for the <optgroup>. */
  group: string
}

export const SERVICE_OPTIONS: readonly ServiceOption[] = [
  { value: GENERAL_ENQUIRY, label: 'General enquiry', group: 'General' },
  ...SERVICES.map((s) => ({
    value: s.id,
    label: s.title,
    group: PILLARS.find((p) => p.id === s.pillar)?.title ?? 'Services',
  })),
]

export function serviceLabel(value: string): string {
  return SERVICE_OPTIONS.find((o) => o.value === value)?.label ?? value
}

export const EMPTY_ENQUIRY: EnquiryInput = {
  name: '',
  email: '',
  phone: '',
  service: '',
  message: '',
}

// Control characters other than tab and newline. Stripped, never trusted.
// biome-ignore lint/suspicious/noControlCharactersInRegex: the point is to match and remove control characters
const CONTROL_CHARS = /[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/g

// Practical address check (HTML living standard shape, but requiring a dot in
// the domain). Rejects spaces, commas and newlines, so it also blocks header
// injection through the email field.
const EMAIL =
  /^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$/

const PHONE_CHARS = /^\+?\s?[0-9(][0-9\s().-]*$/

const asText = (v: unknown): string => (typeof v === 'string' ? v : '')

/** Trim and clean the raw values. Does not judge validity. */
export function normalizeEnquiry(raw: unknown): EnquiryInput {
  const obj = (raw && typeof raw === 'object' ? raw : {}) as Record<
    string,
    unknown
  >
  const singleLine = (v: unknown) =>
    asText(v).replace(CONTROL_CHARS, '').replace(/\s+/g, ' ').trim()
  return {
    name: singleLine(obj.name),
    email: singleLine(obj.email).toLowerCase(),
    phone: singleLine(obj.phone),
    service: singleLine(obj.service),
    message: asText(obj.message)
      .replace(/\r\n?/g, '\n')
      .replace(CONTROL_CHARS, '')
      .trim(),
  }
}

export function validateEnquiry(raw: unknown): EnquiryResult {
  const data = normalizeEnquiry(raw)
  const errors: EnquiryErrors = {}

  if (!data.name) errors.name = 'Please enter your name.'
  else if (data.name.length < ENQUIRY_LIMITS.name.min)
    errors.name = 'Your name looks too short.'
  else if (data.name.length > ENQUIRY_LIMITS.name.max)
    errors.name = `Please keep your name under ${ENQUIRY_LIMITS.name.max} characters.`

  if (!data.email) errors.email = 'Please enter your email address.'
  else if (
    data.email.length > ENQUIRY_LIMITS.email.max ||
    !EMAIL.test(data.email)
  )
    errors.email = 'Please enter a valid email address, like name@example.com.'

  // Optional, but if given it has to look like a phone number.
  if (data.phone) {
    const digits = data.phone.replace(/\D/g, '').length
    if (
      !PHONE_CHARS.test(data.phone) ||
      digits < ENQUIRY_LIMITS.phone.minDigits ||
      digits > ENQUIRY_LIMITS.phone.maxDigits
    )
      errors.phone =
        'Please enter a valid phone number, like +234 802 000 0000.'
  }

  if (!data.service) errors.service = 'Please choose a service.'
  else if (!SERVICE_OPTIONS.some((o) => o.value === data.service))
    errors.service = 'Please choose a service from the list.'

  if (!data.message) errors.message = 'Please tell us how we can help.'
  else if (data.message.length < ENQUIRY_LIMITS.message.min)
    errors.message = 'Please add a little more detail so we can help.'
  else if (data.message.length > ENQUIRY_LIMITS.message.max)
    errors.message = `Please keep your message under ${ENQUIRY_LIMITS.message.max} characters.`

  return Object.keys(errors).length > 0
    ? { ok: false, errors }
    : { ok: true, data }
}
</file>

<file path="lib/figure.ts">
/**
 * Splits a headline figure such as "500+", "30% cost reduction target" or
 * "1,200" into the part that counts up and the text around it, so the number
 * can animate while the rest stays put. Pure functions: no DOM, no React.
 */
export interface Figure {
  /** Text before the number, e.g. "$". */
  prefix: string
  /** The number the count finishes on. */
  value: number
  /** Text after the number, e.g. "+" or "% cost reduction target". */
  suffix: string
  /** Digits after the decimal point in the source figure. */
  decimals: number
  /** True when the source figure used thousands separators ("1,200"). */
  grouped: boolean
}

// Prefix has no digits; the number may use commas and one decimal point.
const FIGURE = /^(\D*?)(\d[\d,]*(?:\.\d+)?)([\s\S]*)$/

/** Returns null when the text holds no number (nothing to count). */
export function parseFigure(text: string): Figure | null {
  const match = FIGURE.exec(text)
  if (!match) return null
  const [, prefix, digits, suffix] = match
  const value = Number(digits.replaceAll(',', ''))
  if (!Number.isFinite(value)) return null
  const dot = digits.indexOf('.')
  return {
    prefix,
    value,
    suffix,
    decimals: dot === -1 ? 0 : digits.length - dot - 1,
    grouped: digits.includes(','),
  }
}

/**
 * Renders the figure at `progress` (0 = start, 1 = finished). Always en-US so
 * the server and the browser print the same characters (no hydration drift).
 */
export function formatFigure(figure: Figure, progress: number): string {
  const clamped = Math.min(1, Math.max(0, progress))
  const current = figure.value * clamped
  const number = new Intl.NumberFormat('en-US', {
    minimumFractionDigits: figure.decimals,
    maximumFractionDigits: figure.decimals,
    useGrouping: figure.grouped,
  }).format(current)
  return `${figure.prefix}${number}${figure.suffix}`
}

/** Ease-out quartic: fast start, long soft landing on the real figure. */
export function easeOutQuart(t: number): number {
  return 1 - (1 - Math.min(1, Math.max(0, t))) ** 4
}
